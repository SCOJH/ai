<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Compendium.Abstractions.AI</AssemblyName>
    <RootNamespace>Compendium.Abstractions.AI</RootNamespace>
    <PackageId>Compendium.Abstractions.AI</PackageId>
    <IsPackable>true</IsPackable>
    <Description>AI/LLM abstractions for Compendium Framework: IAIProvider, IPromptRegistry, IContextBuilder. Provider-agnostic interfaces for AI completions, embeddings, and prompt management.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compendium framework — consumed as published NuGets per ADR-0006/0007. -->
    <PackageReference Include="Compendium.Core" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Compendium.Abstractions.AI.Tests" />
  </ItemGroup>

</Project>
